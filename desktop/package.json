{
  "name": "akira-remote-desktop",
  "version": "1.0.0",
  "description": "AKIRA REMOTE desktop screen viewer and controller",
  "main": "main.js",
  "author": "AKIRA REMOTE",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.akira.remote.desktop",
    "productName": "AKIRA REMOTE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "AKIRA-REMOTE-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "AKIRA-REMOTE-Portable-${version}-${arch}.${ext}"
    }
  }
}
